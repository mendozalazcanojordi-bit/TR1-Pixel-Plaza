# Configuració de l'entorn de desenvolupament (docker-compose.yml).
# Copia aquest fitxer a .env (no es puja al repositori) i canvia les contrasenyes.

# Ports de l'ordinador. Canvia'ls si ja els fa servir una altra cosa (p. ex. el MySQL de XAMPP).
SERVER_PORT=3000
CLIENT_PORT=5173
DB_PORT=3307
ADMINER_PORT=8080

# Base de dades (MySQL). El servidor les rep com a DB_NAME, DB_USER i DB_PASSWORD.
MYSQL_ROOT_PASSWORD=canvia-la-de-root
MYSQL_DATABASE=casinoplaza
MYSQL_USER=casino
MYSQL_PASSWORD=canvia-aquesta
